DATABASE_URL=sqlite+aiosqlite:///./scada.db
DEBUG=true
JWT_SECRET_KEY=local-development-secret-at-least-32-characters
TELEMETRY_SAMPLE_INTERVAL_SECONDS=60
TELEMETRY_RETENTION_DAYS=400
RUNTIME_MODE=combined
# Choose the first customer's credentials before starting the backend.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
