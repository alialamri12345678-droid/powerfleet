# Database Configuration
POSTGRES_DB=scada
POSTGRES_USER=scada_user
POSTGRES_PASSWORD=replace_with_strong_password

# For local development without Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./scada.db
DATABASE_URL=postgresql+asyncpg://scada_user:replace_with_strong_password@localhost:5432/scada

# Security & Tokens
JWT_SECRET_KEY=generate_a_random_32_byte_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080

# Modbus Gateway Settings
MODBUS_POLL_INTERVAL_MS=1000
COMMAND_MIN_RUN_SECONDS=30
COMMAND_MIN_REST_SECONDS=60

# Simulation / Mock Mode
MOCK_MODBUS_ENABLED=true
MOCK_MODBUS_HOST=127.0.0.1
MOCK_MODBUS_PORT=5020
